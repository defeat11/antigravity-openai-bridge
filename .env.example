# antigravity-openai-bridge — environment template
# Copy to .env then run: node --env-file=.env server.js

# HTTP
PORT=3010
HOST=127.0.0.1
MAX_BODY_BYTES=12000000

# Path to the project that exports GeminiAcpClient (gemini-acp.js).
# Empty means: ../gemini-gemini next to this folder.
GEMINI_PROJECT_DIR=
# Working directory handed to the ACP session. Empty means: ./_workspace
GEMINI_WORKSPACE=

# Models
GEMINI_MODEL=gemini-3.5-flash-high
GEMINI_THINK_MODEL=gemini-3.1-pro-high

# Timeouts (ms)
GEMINI_TIMEOUT_MS=300000
GEMINI_THINK_TIMEOUT_MS=600000

# ACP behaviour
GEMINI_ACP_CONTROL_MODE=yolo
GEMINI_STATELESS=false
GEMINI_SESSION_ANCHOR=off
GEMINI_HISTORY_MAX_TURNS=20

# Prompt size guards (characters)
GEMINI_PROMPT_COMPACT_AT=110000
GEMINI_PROMPT_HARD_CAP=20000
TOOL_RESULT_MAX_CHARS=16000

# Debugging: 1 dumps every outgoing prompt to _workspace/last-prompt.txt
GEMINI_DEBUG_PROMPT=0

# Session anchor overrides
ACP_AGY_BIN=agy
ACP_AGY_CONV_DIR=
ACP_AGY_EXTRA_ARGS=
